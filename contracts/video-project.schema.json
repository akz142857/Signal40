{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal40.local/contracts/video-project-v2.schema.json",
  "title": "Signal 40 Video Project 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "research", "script", "timeline", "visuals", "assets", "audio", "captions", "render", "distribution", "provenance"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "identity": {
      "type": "object",
      "required": ["projectId", "topicId", "title", "locale", "brand", "createdAt"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "topicId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "brand": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "required": ["snapshotId", "algorithmVersion", "claims", "conflicts", "approvedHash"],
      "properties": {
        "snapshotId": { "type": "string" },
        "algorithmVersion": { "type": "string" },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "approvedHash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title", "targetDurationSeconds", "disclaimer", "modelVersion", "promptVersion", "humanModifiedBy", "humanModifiedAt", "lines"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "targetDurationSeconds": { "type": "number", "minimum": 30, "maximum": 90 },
        "disclaimer": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 },
        "humanModifiedBy": { "type": ["string", "null"] },
        "humanModifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scriptLine" } }
      }
    },
    "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } },
    "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "voice", "objectKey", "durationMs", "speed", "pronunciationDictionary", "sha256", "fallbackProvider", "estimatedCostMicros", "music", "mix"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "voice": {"type": ["string", "null"]},
        "objectKey": {"type": ["string", "null"]},
        "durationMs": {"type": ["integer", "null"], "minimum": 1},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2},
        "pronunciationDictionary": {"type": "object", "additionalProperties": {"type": "string"}},
        "sha256": {"type": ["string", "null"]},
        "fallbackProvider": {"type": ["string", "null"]},
        "estimatedCostMicros": {"type": "integer", "minimum": 0},
        "music": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["assetId", "objectKey", "volume", "loop"],
          "properties": {
            "assetId": {"type": "string"},
            "objectKey": {"type": "string"},
            "volume": {"type": "number", "minimum": 0, "maximum": 0.5},
            "loop": {"type": "boolean"}
          }
        },
        "mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["voiceVolume", "targetLufs", "duckMusicUnderVoice"],
          "properties": {
            "voiceVolume": {"type": "number", "minimum": 0, "maximum": 2},
            "targetLufs": {"type": "number", "minimum": -24, "maximum": -10},
            "duckMusicUnderVoice": {"type": "boolean"}
          }
        }
      }
    },
    "captions": { "type": "array", "items": { "$ref": "#/$defs/caption" } },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compositionId", "templateId", "templateVersion", "fps", "width", "height", "durationSeconds", "snapshotHash"],
      "properties": {
        "compositionId": { "const": "Signal40Vertical" },
        "templateId": { "enum": ["signal40-editorial", "signal40-terminal", "signal40-brief"] },
        "templateVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "fps": { "const": 30 },
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "durationSeconds": { "type": "number", "minimum": 30, "maximum": 90 },
        "snapshotHash": { "type": "string", "minLength": 16 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelPreset", "accountId", "title", "description", "tags", "coverAssetId", "scheduledAt", "finalUrl"],
      "properties": {
        "channelPreset": { "type": ["string", "null"], "enum": ["package", "youtube", null] },
        "accountId": { "type": ["string", "null"], "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 50 } },
        "coverAssetId": { "type": ["string", "null"] },
        "scheduledAt": { "type": ["string", "null"], "format": "date-time" },
        "finalUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedBy", "sourceProjectVersion", "immutableInputsHash"],
      "properties": {
        "generatedBy": { "type": "string", "minLength": 1 },
        "sourceProjectVersion": { "type": "string", "minLength": 1 },
        "immutableInputsHash": { "type": "string", "minLength": 16 }
      }
    }
  },
  "$defs": {
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "description", "resolution"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "spec"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["chart", "text", "image", "source-card"] },
        "spec": { "type": "object" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind", "quantity", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["fact", "numeric", "comparison", "causal", "prediction", "analysis", "opinion", "disclaimer"] },
        "quantity": {
          "type": ["object", "null"],
          "required": ["value", "unit", "currency", "timeRange", "basis", "entity", "uncertainty"],
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string" },
            "currency": { "type": ["string", "null"] },
            "timeRange": { "type": "string" },
            "basis": { "type": "string" },
            "entity": { "type": "string" },
            "uncertainty": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "articleRevisionId", "url", "stance", "quote", "observedAt", "locator"],
      "properties": {
        "sourceId": { "type": "string" },
        "articleRevisionId": { "type": ["string", "null"] },
        "url": { "type": "string", "format": "uri" },
        "stance": { "enum": ["supports", "refutes", "context"] },
        "quote": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": { "type": { "enum": ["page", "paragraph", "table", "timecode", "section", "url"] }, "value": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "scriptLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "screenText", "claimIds", "pronunciationHints"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "screenText": { "type": "string", "minLength": 1 },
        "claimIds": { "type": "array", "items": { "type": "string" } },
        "pronunciationHints": { "type": "object", "additionalProperties": { "type": "string" } },
        "locked": { "type": "boolean" },
        "comment": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objectKey", "mediaType", "rightsStatus", "rightsNote", "sha256", "usageScope", "provenance", "retentionUntil", "crop", "derivedFromAssetId"],
      "properties": {
        "id": { "type": "string" }, "objectKey": { "type": "string" }, "mediaType": { "type": "string" },
        "rightsStatus": { "enum": ["cleared", "restricted", "unknown"] }, "rightsNote": { "type": "string" }, "sha256": { "type": "string" },
        "usageScope": { "type": "string", "minLength": 1 },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["kind", "source", "model", "prompt", "generatedAt"], "properties": { "kind": { "enum": ["uploaded", "generated", "derived"] }, "source": { "type": "string" }, "model": { "type": ["string", "null"] }, "prompt": { "type": ["string", "null"] }, "generatedAt": { "type": ["string", "null"], "format": "date-time" } } },
        "retentionUntil": { "type": ["string", "null"], "format": "date-time" },
        "crop": { "type": ["object", "null"], "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false },
        "derivedFromAssetId": { "type": ["string", "null"] }
      }
    },
    "caption": {
      "type": "object", "additionalProperties": false,
      "required": ["startMs", "endMs", "text", "lineId", "granularity", "style", "safeArea", "manuallyEdited"],
      "properties": {
        "startMs": { "type": "integer", "minimum": 0 }, "endMs": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 }, "lineId": { "type": "string" },
        "granularity": { "enum": ["sentence", "word"] }, "style": { "enum": ["default", "emphasis", "disclaimer"] }, "manuallyEdited": { "type": "boolean" },
        "safeArea": { "type": "object", "additionalProperties": false, "required": ["left", "right", "top", "bottom"], "properties": { "left": { "type": "integer", "minimum": 0 }, "right": { "type": "integer", "minimum": 0 }, "top": { "type": "integer", "minimum": 0 }, "bottom": { "type": "integer", "minimum": 0 } } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startFrame", "durationFrames", "kind", "narrationLineIds", "visualId", "transition", "visualIntent", "screenText", "sourceFootnote", "motion"],
      "properties": {
        "id": { "type": "string" },
        "startFrame": { "type": "integer", "minimum": 0 },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["hero-number", "comparison", "trend", "breakdown", "takeaway"] },
        "narrationLineIds": { "type": "array", "items": { "type": "string" } },
        "visualId": { "type": ["string", "null"] },
        "transition": { "enum": ["cut", "fade", "slide", "zoom"] },
        "visualIntent": { "type": "string", "minLength": 1 },
        "screenText": { "type": "string" },
        "sourceFootnote": { "type": "string" },
        "motion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
