{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal40.local/contracts/video-project.schema.json",
  "title": "Signal 40 Video Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "topic", "claims", "sources", "scenes", "brand", "render"],
  "properties": {
    "version": { "const": "1.0" },
    "topic": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "score"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "score": { "type": "integer", "minimum": 0, "maximum": 100 } }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["text", "sourceIds"], "properties": { "text": { "type": "string", "minLength": 1 }, "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
    },
    "sources": {
      "type": "array", "minItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "url", "sourceType"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "sourceType": { "enum": ["social", "media", "market", "filing", "company"] } } }
    },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "startFrame", "durationFrames", "kind", "narration"], "properties": { "id": { "type": "string" }, "startFrame": { "type": "integer", "minimum": 0 }, "durationFrames": { "type": "integer", "minimum": 1 }, "kind": { "enum": ["hero-number", "comparison", "trend", "breakdown", "takeaway"] }, "narration": { "type": "string" }, "data": { "type": "object" } } }
    },
    "audio": { "type": ["object", "null"] },
    "captions": { "type": "array", "items": { "type": "object" } },
    "brand": { "type": "object", "additionalProperties": false, "required": ["name", "locale"], "properties": { "name": { "type": "string" }, "locale": { "const": "zh-CN" } } },
    "render": { "type": "object", "additionalProperties": false, "required": ["fps", "width", "height", "durationSeconds"], "properties": { "fps": { "const": 30 }, "width": { "const": 1080 }, "height": { "const": 1920 }, "durationSeconds": { "type": "number", "minimum": 35, "maximum": 50 } } }
  }
}
