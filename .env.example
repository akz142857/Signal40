# Makefile 的本机默认端口；避开常被其他前端占用的 3000。
# 改这里就必须同步改下面的 SIGNAL40_CONTROL_URL：`vinext start` 取 PORT，
# 而 Worker 只认 SIGNAL40_CONTROL_URL 一个地址，两者不一致时 Worker 连不上
# 控制面，且不会报错——它只是永远领不到作业。
PORT=3001

# ── 控制面：数据库 ────────────────────────────────────────────────
# 默认指向 docker-compose 起的本地实例（宿主端口 55432）。
# 已有自己的 PostgreSQL 就改成你的连接串。
DATABASE_URL=postgres://signal40:signal40@127.0.0.1:55432/signal40
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ── 控制面：对象存储（Cloudflare R2 的 S3 兼容端点）─────────────────
# 在 Cloudflare 控制台 R2 → Manage API Tokens 建一个有对象读写权限的 Token，
# 拿到 Access Key ID / Secret Access Key；端点里的 <account_id> 在 R2 概览页。
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=signal40-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CHECKSUM_MODE=WHEN_REQUIRED

# ── 控制面：鉴权与密钥 ────────────────────────────────────────────
# 本机通过 localhost 访问时可用 x-signal-role 头伪造角色，不需要下面这些。
BOOTSTRAP_ADMIN_EMAILS=
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
# 手动触发编排的接口（POST /api/v1/scheduler/run）需要它。
SCHEDULER_TOKEN=
# 入站 Webhook 的 HMAC 密钥。留空是 fail closed：未配置时
# /api/v1/webhooks/youtube 一律返回 401，而不是放行未签名请求。
WEBHOOK_SECRET=
RENDER_CONCURRENCY_LIMIT=2
# 每月渲染成本上限（微元）。0 表示**不设上限**，不是零预算——
# 作业入队处是 `if (budget > 0)` 才校验。上真实环境前请设成实际值。
MONTHLY_RENDER_BUDGET_MICROS=0

# ── 生产身份（脱离 OpenAI Sites 后必配）─────────────────────────────
# 非本地请求的身份来自反向代理注入的头。默认沿用历史头名，
# 自建的认证代理注入自己的头名时在这里改。
SIGNAL40_IDENTITY_HEADER_ID=oai-authenticated-user-id
SIGNAL40_IDENTITY_HEADER_EMAIL=oai-authenticated-user-email
# 生产必须置为 false：为 true 时本机请求可以用 x-signal-role 伪造角色，
# 「独立发布人」就由前端说了算，G7 的职责分离不成立。
SIGNAL40_ALLOW_LOCAL_ROLE_HEADERS=true

# ── 自动化（编排引擎）─────────────────────────────────────────────
# 机械步骤以这个服务账号的身份写入；它必须是 team_members 里 active 且角色为 admin 的成员。
# 不配时引擎一律不写入，并在待办箱里留一条说明（失败方向是关，不是开）。
SIGNAL40_AUTOMATION_ACTOR_ID=
# 调度器进程的轮询间隔（毫秒），最小 5000。
SIGNAL40_SCHEDULER_INTERVAL_MS=30000
# 待办箱外部通知地址；签名用 WEBHOOK_SECRET，格式 HMAC(secret, "<timestamp>.<body>")。
# 不配就只能在 /inbox 页面里看到待办。
SIGNAL40_ATTENTION_WEBHOOK_URL=

# ── Worker ───────────────────────────────────────────────────────
# Worker 回报控制面的地址；必须与上面 PORT 指向同一个监听端口。
SIGNAL40_CONTROL_URL=http://127.0.0.1:3001
# 共享令牌只在本机开发可用：combined profile 需要它，生产模式下
# lib/workload-env.ts 会直接拒绝启动。分离部署请只配下面两个 profile 专用令牌。
SIGNAL40_WORKER_TOKEN=local-development
SIGNAL40_SOURCE_WORKER_TOKEN=
SIGNAL40_RENDER_WORKER_TOKEN=
# 分离部署优先使用两个 profile 专用 ID；兼容 combined 模式才读取 SIGNAL40_WORKER_ID。
SIGNAL40_SOURCE_WORKER_ID=source-worker-1
SIGNAL40_RENDER_WORKER_ID=render-worker-1
SIGNAL40_WORKER_ID=combined-worker-1
# 微信/小红书选择 OpenCLI 发现方式时，由 Source Worker 执行这个二进制。
# 默认值只有在通过 npm script 启动 Worker 时才解析得到（node_modules/.bin 才在 PATH 上）；
# 用 docker、systemd 或直接 `node render-worker/worker.ts` 起 Worker 时会拿到
# OPENCLI_UNAVAILABLE 终态失败。这些场景请填绝对路径。
# 另注：OpenCLI 还需要 Browser Bridge 浏览器扩展已连接，`opencli doctor` 可查。
SIGNAL40_OPENCLI_BIN=opencli

# 云端配音与字幕对齐（只有 Worker 用；不配就跑不了 voice 作业，其余流程不受影响）
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# YouTube 发布（不配就只能用 package 渠道产出发布包）
YOUTUBE_ACCESS_TOKEN=
# 保持 false：为 true 之前所有上传都强制 private，这是发布的 fail-safe
SIGNAL40_ALLOW_PUBLIC_PUBLISH=false
