{
  "name": "signal-40",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --env-file-if-exists=.env --test --experimental-strip-types test/*.test.ts",
    "test:render": "node --env-file-if-exists=.env --experimental-strip-types scripts/render-smoke.ts",
    "test:evaluation": "node --experimental-strip-types scripts/evaluate-finance-events.ts",
    "render": "node --experimental-strip-types scripts/render-video.ts",
    "project:migrate": "node --experimental-strip-types scripts/migrate-project.ts",
    "project:export-local": "node --env-file-if-exists=.env --experimental-strip-types scripts/export-local-project.ts",
    "contracts:rehash-local": "node --env-file-if-exists=.env --experimental-strip-types scripts/rehash-local.ts",
    "drill:restore": "./scripts/restore-drill.sh",
    "source-slo:report": "node --env-file-if-exists=.env --experimental-strip-types scripts/source-slo-report.ts",
    "source:chaos": "node --experimental-strip-types scripts/source-chaos-report.ts",
    "social-evidence:evaluate": "node --experimental-strip-types scripts/evaluate-social-evidence.ts",
    "source:sensitive-canary": "node --experimental-strip-types scripts/verify-source-sensitive-canary.ts",
    "voice:local": "node --env-file-if-exists=.env --experimental-strip-types scripts/generate-local-voice.ts",
    "qc:media": "node --experimental-strip-types scripts/media-qc.ts",
    "worker": "node --env-file-if-exists=.env --experimental-strip-types render-worker/worker.ts",
    "worker:source": "SIGNAL40_WORKER_PROFILE=source node --env-file-if-exists=.env --experimental-strip-types render-worker/worker.ts",
    "worker:render": "SIGNAL40_WORKER_PROFILE=render node --env-file-if-exists=.env --experimental-strip-types render-worker/worker.ts",
    "scheduler": "node --env-file-if-exists=.env --experimental-strip-types scripts/scheduler.ts",
    "lint": "oxlint",
    "openapi:lint": "redocly lint contracts/openapi.yaml --max-problems=500",
    "openapi:breaking": "node --experimental-strip-types scripts/check-openapi-compatibility.ts",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrations:verify": "node --experimental-strip-types scripts/verify-migrations.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate-pg.ts",
    "walk": "node --env-file-if-exists=.env --experimental-strip-types scripts/walk-workflow.ts",
    "ingest:real": "node --env-file-if-exists=.env --experimental-strip-types scripts/ingest-real-feeds.ts",
    "check:storage": "node --env-file-if-exists=.env --experimental-strip-types scripts/check-storage.ts",
    "image:canary:prepare": "node --experimental-strip-types scripts/prepare-image-scan-canary.ts",
    "image:canary:cleanup": "node --experimental-strip-types scripts/prepare-image-scan-canary.ts --cleanup",
    "image:verify": "node --experimental-strip-types scripts/verify-workload-image.ts",
    "compose:env:verify": "node --experimental-strip-types scripts/verify-compose-runtime-env.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@base-ui/react": "1.7.0",
    "@electric-sql/pglite": "^0.5.8",
    "@remotion/bundler": "^4.0.522",
    "@remotion/media": "^4.0.522",
    "@remotion/player": "^4.0.522",
    "@remotion/renderer": "^4.0.522",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "1.4.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "remotion": "^4.0.522",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "7.29.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@redocly/cli": "^2.51.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
