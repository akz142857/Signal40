{
  "name": "signal-40",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:render": "node --experimental-strip-types scripts/render-smoke.ts",
    "test:evaluation": "node --experimental-strip-types scripts/evaluate-finance-events.ts",
    "render": "node --experimental-strip-types scripts/render-video.ts",
    "project:migrate": "node --experimental-strip-types scripts/migrate-project.ts",
    "project:export-local": "node --experimental-strip-types scripts/export-local-project.ts",
    "contracts:rehash-local": "node --experimental-strip-types scripts/rehash-local.ts",
    "drill:restore": "./scripts/restore-drill.sh",
    "voice:local": "node --experimental-strip-types scripts/generate-local-voice.ts",
    "qc:media": "node --experimental-strip-types scripts/media-qc.ts",
    "worker": "node --experimental-strip-types render-worker/worker.ts",
    "ingest:weixin": "node scripts/opencli-weixin.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/logs MINIFLARE_REGISTRY_PATH=.wrangler/registry wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state"
  },
